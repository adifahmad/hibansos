<%- include('../partials/header', { title: "Kelola Pengajuan", user }) %>

<div id="layoutSidenav_nav">
  <nav class="sb-sidenav accordion spotify-green">
    <div class="sb-sidenav-menu">
      <%- include('../partials/menu/admin') %>
    </div>
  </nav>
</div>

<div id="layoutSidenav_content">
  <main>
    <div class="container-fluid px-4 mt-4">

      <h1 class="fw-bold mb-3">Kelola Pengajuan</h1>

      <div class="card shadow-sm">
        <div class="card-body p-0">

          <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Judul</th>
                <th>Pemohon</th>
                <th>Kategori</th>
                <th>Dana</th>
                <th>Status</th>
                <th style="width:280px">Aksi</th>
              </tr>
            </thead>
            <tbody>

              <% if (data.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center text-muted py-4">
                    Tidak ada pengajuan
                  </td>
                </tr>
              <% } %>

              <% data.forEach(p => { %>
                <tr>
                  <td><%= p.title %></td>
                  <td><%= p.pemohon %></td>
                  <td><%= p.category %></td>
                  <td>Rp <%= Number(p.request_amount).toLocaleString('id-ID') %></td>
                  <td>
                    <span class="badge bg-secondary"><%= p.status %></span>
                  </td>

                  <td>
                    <form method="POST"
                          action="/users/admin/pengajuan/<%= p.application_id %>/assign"
                          class="d-flex gap-1">

                      <select name="status" class="form-select form-select-sm">
                        <option value="submitted">Submitted</option>
                        <option value="under_review">Review</option>
                        <option value="approved">Approve</option>
                        <option value="rejected">Reject</option>
                      </select>

                      <button class="btn btn-sm btn-success">
                        Simpan
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>

            </tbody>
          </table>

        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</div>
