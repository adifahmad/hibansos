<%- include('../partials/header', { title: "Detail Tracking Pengajuan" , user }) %>

<div id="layoutSidenav">

  <!-- SIDEBAR -->
  <div id="layoutSidenav_nav">
    <nav class="sb-sidenav accordion spotify-green">
      <div class="sb-sidenav-menu">
        <%- include('../partials/menu/admin') %>
      </div>
    </nav>
  </div>

  <!-- CONTENT -->
  <div id="layoutSidenav_content">
    <main class="container-fluid px-4 mt-4 tracking-detail-page">
      <div class="container-fluid px-4 mt-4">

        <h1 class="fw-bold mb-4">Detail Tracking Pengajuan</h1>

        <%
          let label = "Menunggu Review";
          let badge = "bg-info";

          if (data[0].review_status === 'rejected') {
            label = "Ditolak (Reviewer)";
            badge = "bg-danger";
          }
          else if (data[0].review_status === 'approved' && !data[0].recommendation) {
            label = "Menunggu Evaluasi";
            badge = "bg-warning text-dark";
          }
          else if (data[0].recommendation === 'reject') {
            label = "Ditolak (Evaluator)";
            badge = "bg-danger";
          }
          else if (data[0].recommendation === 'approve') {
            label = "Disetujui";
            badge = "bg-success";
          }
        %>

        <!-- INFO UTAMA -->
        <div class="card mb-4 shadow-sm">
          <div class="card-body">

            <p><b>Judul:</b> <%= data[0].title %></p>
            <p><b>Pemohon:</b> <%= data[0].pemohon %></p>
            <p><b>Alamat Pemohon:</b><br>
              <%= data[0].address || '-' %>
            </p>

            <p>
              <b>Status:</b>
              <span class="badge <%= badge %>">
                <%= label %>
              </span>
            </p>

          </div>
        </div>

        <!-- INFO KEGIATAN -->
        <div class="card mb-4 shadow-sm">
          <div class="card-header fw-bold">
            Informasi Kegiatan
          </div>
          <div class="card-body">

            <p>
              <b>Penerima Manfaat:</b><br>
              <%= data[0].beneficiaries_count || 0 %> Orang
            </p>

            <p>
              <b>Alamat Kegiatan:</b><br>
              <%= data[0].location_detail || '-' %>
            </p>

            <% if (data[0].latitude && data[0].longitude) { %>
              <div class="mt-3">
                <iframe
                  width="100%"
                  height="250"
                  style="border:0; border-radius:8px"
                  loading="lazy"
                  src="https://www.google.com/maps?q=<%= data[0].latitude %>,<%= data[0].longitude %>&hl=id&z=15&output=embed">
                </iframe>
              </div>
            <% } %>

          </div>
        </div>

        <!-- TRACKING TIMELINE -->
        <div class="card mb-4 shadow-sm">
          <div class="card-header fw-bold">
            Timeline Proses
          </div>
          <div class="card-body">

            <ul class="list-group">

              <li class="list-group-item">
                <b>Diajukan</b><br>
                <small class="text-muted">
                  <%= data[0].submission_date
                    ? new Date(data[0].submission_date).toLocaleString('id-ID')
                    : '-' %>
                </small>
              </li>

              <li class="list-group-item">
                <b>Review</b><br>
                <small class="text-muted">
                  <%= data[0].reviewed_at
                    ? new Date(data[0].reviewed_at).toLocaleString('id-ID')
                    : 'Belum direview' %>
                </small>
              </li>

              <li class="list-group-item">
                <b>Evaluasi / Keputusan</b><br>
                <small class="text-muted">
                  <%= data[0].evaluated_at
                    ? new Date(data[0].evaluated_at).toLocaleString('id-ID')
                    : 'Belum selesai' %>
                </small>
              </li>

            </ul>

          </div>
        </div>

        <!-- DOKUMEN -->
        <div class="card shadow-sm">
          <div class="card-header fw-bold">
            Dokumen Terkait
          </div>
          <div class="card-body">

            <% const docs = data.filter(d => d.file_path); %>

            <% if (docs.length === 0) { %>
              <p class="text-muted">Tidak ada dokumen.</p>
            <% } else { %>
              <ul class="list-group">
                <% docs.forEach(d => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                      <i class="fas fa-file"></i>
                      <%= d.file_name %>
                    </span>
                    <a href="/uploads/<%= d.file_path %>"
                       target="_blank"
                       class="btn btn-sm btn-outline-primary">
                      Lihat
                    </a>
                  </li>
                <% }) %>
              </ul>
            <% } %>

          </div>
        </div>

        <a href="/users/admin/laporan"
           class="btn btn-secondary mt-4">
          ← Kembali
        </a>

      </div>
    </main>
  </div>
</div>