<%- include('../partials/header', { title: "Detail Tracking Pengajuan", user }) %>

<div id="layoutSidenav">

  <!-- SIDEBAR -->
  <div id="layoutSidenav_nav">
    <nav class="sb-sidenav accordion spotify-green">
      <div class="sb-sidenav-menu">
        <%- include('../partials/menu/admin') %>
      </div>
    </nav>
  </div>

  <!-- CONTENT -->
  <div id="layoutSidenav_content">
    <main class="container-fluid px-4 mt-4 tracking-detail-page">
      <div class="container-fluid px-4 mt-4">

        <h1 class="fw-bold mb-4">Detail Tracking Pengajuan</h1>

        <!-- INFO UTAMA -->
        <div class="card mb-4 shadow-sm">
          <div class="card-body">
            <p><b>Judul:</b> <%= data[0].title %></p>
            <p><b>Pemohon:</b> <%= data[0].pemohon %></p>
            <p>
              <b>Status:</b>
              <span class="badge
                <%= data[0].status === 'approved'
                  ? 'bg-success'
                  : data[0].status === 'rejected'
                  ? 'bg-danger'
                  : 'bg-info' %>">
                <%= data[0].status %>
              </span>
            </p>
          </div>
        </div>

        <!-- TRACKING TIMELINE -->
        <div class="card mb-4 shadow-sm">
          <div class="card-header fw-bold">
            Timeline Proses
          </div>
          <div class="card-body">

            <ul class="list-group">

              <li class="list-group-item">
                <b>Diajukan</b><br>
                <small class="text-muted">
                  <%= data[0].submission_date
                    ? new Date(data[0].submission_date).toLocaleString('id-ID')
                    : '-' %>
                </small>
              </li>

              <li class="list-group-item">
                <b>Review</b><br>
                <small class="text-muted">
                  <%= data[0].reviewed_at
                    ? new Date(data[0].reviewed_at).toLocaleString('id-ID')
                    : 'Belum direview' %>
                </small>
              </li>

              <li class="list-group-item">
                <b>Evaluasi / Keputusan</b><br>
                <small class="text-muted">
                  <%= data[0].evaluated_at
                    ? new Date(data[0].evaluated_at).toLocaleString('id-ID')
                    : 'Belum selesai' %>
                </small>
              </li>

            </ul>

          </div>
        </div>

        <!-- DOKUMEN -->
        <div class="card shadow-sm">
          <div class="card-header fw-bold">
            Dokumen Terkait
          </div>
          <div class="card-body">

            <% const docs = data.filter(d => d.file_path); %>

            <% if (docs.length === 0) { %>
              <p class="text-muted">Tidak ada dokumen.</p>
            <% } else { %>
              <ul class="list-group">
                <% docs.forEach(d => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                      <i class="fas fa-file"></i>
                      <%= d.file_name %>
                    </span>
                    <a href="/uploads/<%= d.file_path %>"
                       target="_blank"
                       class="btn btn-sm btn-outline-primary">
                      Lihat
                    </a>
                  </li>
                <% }) %>
              </ul>
            <% } %>

          </div>
        </div>

        <a href="/users/admin/laporan"
           class="btn btn-secondary mt-4">
          ← Kembali
        </a>

      </div>
    </main>

  </div>
</div>
