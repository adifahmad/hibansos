<%- include('../partials/header', { title: "Detail Legalitas Bansos" , user }) %>

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion spotify-green">
                <div class="sb-sidenav-menu">
                    <%- include('../partials/menu/admin') %>
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main class="admin-legalitas-page">
                <div class="card shadow-sm legalitas-list-card">
                    <div class="container-fluid px-4 mt-4">

                        <h1 class="fw-bold">Detail Legalitas Bansos</h1>

                        <div class="card mb-4">
                            <div class="card-body">

                                <p><b>Nama:</b>
                                    <%= data.name %>
                                </p>
                                <p><b>NIK:</b>
                                    <%= data.nik || '-' %>
                                </p>
                                <p><b>No KK:</b>
                                    <%= data.no_kk || '-' %>
                                </p>

                                <p>
                                    <b>Alamat Lengkap:</b><br>
                                    <%= data.address || '-' %>
                                </p>

                                <% if (data.latitude && data.longitude) { %>
                                    <div class="mt-3">
                                        <b>Lokasi Peta:</b>
                                        <iframe width="100%" height="250" style="border:0; border-radius:8px"
                                            loading="lazy"
                                            src="https://www.google.com/maps?q=<%= data.latitude %>,<%= data.longitude %>&hl=id&z=15&output=embed">
                                        </iframe>
                                    </div>
                                    <% } %>

                                        <p class="mt-3">
                                            <b>Status:</b>
                                            <span
                                                class="badge <%= data.verification_status === 'approved' ? 'bg-success' : data.verification_status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark' %>">
                                                <%= data.verification_status %>
                                            </span>
                                        </p>

                            </div>
                        </div>

                        <div class="card">
                            <div class="card-body">

                                <form method="POST"
                                    action="/users/admin/legalitas-bansos/<%= data.legality_id %>/verifikasi">

                                    <div class="mb-3">
                                        <label class="fw-bold">Status Verifikasi</label>
                                        <select name="verification_status" class="form-select" required>
                                            <option value="">-- Pilih --</option>
                                            <option value="approved">Approve</option>
                                            <option value="rejected">Reject</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="fw-bold">Catatan Admin</label>
                                        <textarea name="verification_notes" class="form-control" rows="3"></textarea>
                                    </div>

                                    <button class="btn btn-success fw-bold">
                                        Simpan Verifikasi
                                    </button>

                                    <a href="/users/admin/legalitas" class="btn btn-secondary ms-2">
                                        Kembali
                                    </a>

                                </form>

                            </div>
                        </div>

                    </div>
            </main>
        </div>
    </div>