<%- include('../partials/header', { title: "Verifikasi Legalitas" , user }) %>

    <div id="layoutSidenav">

        <!-- SIDEBAR -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion spotify-green">
                <div class="sb-sidenav-menu">
                    <%- include('../partials/menu/admin') %>
                </div>
            </nav>
        </div>

        <!-- CONTENT -->
        <div id="layoutSidenav_content">
            <main class="admin-legalitas-page">
                <div class="card shadow-sm legalitas-list-card">
                    <div class="container-fluid px-4 mt-4">

                        <h1 class="fw-bold">Verifikasi Legalitas</h1>
                        <p class="text-muted">Daftar legalitas lembaga dan bansos yang diajukan pemohon.</p>

                        <!-- ================= HIBAH ================= -->
                        <div class="card shadow-sm mb-5">
                            <div class="card-body">

                                <h5 class="fw-bold mb-3">Legalitas Hibah</h5>

                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped w-100">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nama</th>
                                                <th>Organisasi</th>
                                                <th>NPWP</th>
                                                <th>Status</th>
                                                <th>Dokumen</th>
                                                <th style="width:140px">Aksi</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <% if (!data || data.length===0) { %>
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted">
                                                        Tidak ada data hibah
                                                    </td>
                                                </tr>
                                                <% } else { %>

                                                    <% data.forEach(l=> { %>
                                                        <tr>

                                                            <td>
                                                                <%= l.name %>
                                                            </td>
                                                            <td>
                                                                <%= l.organization %>
                                                            </td>
                                                            <td>
                                                                <%= l.npwp %>
                                                            </td>

                                                            <td>
                                                                <span class="badge
                                                            <%= l.verification_status === 'approved'
                                                            ? 'bg-success'
                                                            : l.verification_status === 'rejected'
                                                            ? 'bg-danger'
                                                            : 'bg-warning text-dark' %>">
                                                                    <%= l.verification_status %>
                                                                </span>
                                                            </td>

                                                            <td>
                                                                <% if (!l.documents || l.documents.length===0) { %>
                                                                    <span class="text-muted">Tidak ada</span>
                                                                    <% } else { %>
                                                                        <% l.documents.forEach(doc=> { %>
                                                                            <a href="/uploads/<%= doc.file_path %>"
                                                                                target="_blank"
                                                                                class="btn btn-sm btn-outline-danger me-1 mb-1">
                                                                                <i class="fas fa-file-pdf"></i>
                                                                                <%= doc.file_type.toUpperCase() %>
                                                                            </a>
                                                                            <% }) %>
                                                                                <% } %>
                                                            </td>

                                                            <td class="text-nowrap">
                                                                <% if (l.verification_status !=='approved' ) { %>

                                                                    <a href="/users/admin/legalitas/<%= l.legality_id %>"
                                                                        class="btn btn-sm btn-info mb-1">
                                                                        <i class="fas fa-eye"></i> Detail
                                                                    </a>

                                                                    <a href="/users/admin/legalitas/<%= l.legality_id %>/edit"
                                                                        class="btn btn-sm btn-warning mb-1">
                                                                        <i class="fas fa-edit"></i> Edit
                                                                    </a>

                                                                    <% } else { %>
                                                                        <span class="text-muted fst-italic">
                                                                            ✔ Sudah disetujui
                                                                        </span>
                                                                        <% } %>
                                                            </td>

                                                        </tr>
                                                        <% }) %>

                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>

                        <!-- ================= BANSOS ================= -->
                        <div class="card shadow-sm">
                            <div class="card-body">

                                <h5 class="fw-bold mb-3">Legalitas Bansos</h5>

                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped w-100">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nama</th>
                                                <th>NIK</th>
                                                <th>No KK</th>
                                                <th>Status</th>
                                                <th>Dokumen</th>
                                                <th style="width:140px">Aksi</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <% if (!bansos || bansos.length===0) { %>
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted">
                                                        Tidak ada data bansos
                                                    </td>
                                                </tr>
                                                <% } else { %>

                                                    <% bansos.forEach(l=> { %>
                                                        <tr>

                                                            <td>
                                                                <%= l.name %>
                                                            </td>
                                                            <td>
                                                                <%= l.nik %>
                                                            </td>
                                                            <td>
                                                                <%= l.no_kk %>
                                                            </td>

                                                            <td>
                                                                <span class="badge
                                                            <%= l.verification_status === 'approved'
                                                            ? 'bg-success'
                                                            : l.verification_status === 'rejected'
                                                            ? 'bg-danger'
                                                            : 'bg-warning text-dark' %>">
                                                                    <%= l.verification_status %>
                                                                </span>
                                                            </td>

                                                            <td>
                                                                <% if (!l.documents || l.documents.length===0) { %>
                                                                    <span class="text-muted">Tidak ada</span>
                                                                    <% } else { %>
                                                                        <% l.documents.forEach(doc=> { %>
                                                                            <a href="/uploads/<%= doc.file_path %>"
                                                                                target="_blank"
                                                                                class="btn btn-sm btn-outline-primary me-1 mb-1">
                                                                                <i class="fas fa-file"></i>
                                                                                Lihat
                                                                            </a>
                                                                            <% }) %>
                                                                                <% } %>
                                                            </td>

                                                            <td class="text-nowrap">

                                                                <% if (l.verification_status !=='approved' ) { %>

                                                                    <a href="/users/admin/legalitas-bansos/<%= l.legality_id %>"
                                                                        class="btn btn-sm btn-info mb-1">
                                                                        <i class="fas fa-eye"></i> Detail
                                                                    </a>

                                                                    <a href="/users/admin/legalitas-bansos/<%= l.legality_id %>/edit"
                                                                        class="btn btn-sm btn-warning mb-1">
                                                                        <i class="fas fa-edit"></i> Edit
                                                                    </a>

                                                                    <% } else { %>
                                                                        <span class="text-muted fst-italic">
                                                                            ✔ Sudah disetujui
                                                                        </span>
                                                                        <% } %>

                                                            </td>

                                                        </tr>
                                                        <% }) %>

                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </main>
        </div>
    </div>