<%- include('../partials/header', { title: "Edit Legalitas" , user }) %>

    <div id="layoutSidenav_nav">
        <nav class="sb-sidenav accordion spotify-green">
            <div class="sb-sidenav-menu">
                <%- include('../partials/menu/admin') %>
            </div>
        </nav>
    </div>

    <div id="layoutSidenav_content">
        <main class="container-fluid px-4 mt-4">

            <h1 class="fw-bold mb-3">Edit Legalitas</h1>

            <div class="card shadow-sm">
                <div class="card-body">

                    <p><b>Nama:</b>
                        <%= legalitas.name %>
                    </p>
                    <p><b>Organisasi:</b>
                        <%= legalitas.organization %>
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Nomor Akta</label>
                        <input type="text" name="deed_number" class="form-control"
                            value="<%= legalitas.deed_number || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notaris</label>
                        <input type="text" name="notary_name" class="form-control"
                            value="<%= legalitas.notary_name || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">NPWP</label>
                        <input type="text" name="npwp" class="form-control" value="<%= legalitas.npwp || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">NIB</label>
                        <input type="text" name="nib" class="form-control" value="<%= legalitas.nib || '' %>">
                    </div>

                    <hr>

                    <form method="POST" action="/users/admin/legalitas/<%= legalitas.legality_id %>/update">

                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select name="verification_status" class="form-select">
                                <option value="pending" <%=legalitas.verification_status==='pending' ? 'selected' : ''
                                    %>>Pending</option>
                                <option value="approved" <%=legalitas.verification_status==='approved' ? 'selected' : ''
                                    %>>Approved</option>
                                <option value="rejected" <%=legalitas.verification_status==='rejected' ? 'selected' : ''
                                    %>>Rejected</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Catatan</label>
                            <textarea name="verification_notes" class="form-control"
                                rows="3"><%= legalitas.verification_notes || '' %></textarea>
                        </div>

                        <button class="btn btn-success">
                            <i class="fas fa-save"></i> Simpan
                        </button>

                        <a href="/users/admin/legalitas" class="btn btn-secondary ms-2">
                            Kembali
                        </a>

                    </form>

                </div>
            </div>

        </main>
        <%- include('../partials/footer') %>
    </div>
    </div>