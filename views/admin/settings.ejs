<%- include('../partials/header', { title: "Pengaturan Sistem", user }) %>

<div id="layoutSidenav_nav">
  <nav class="sb-sidenav accordion spotify-green">
    <div class="sb-sidenav-menu">
      <%- include('../partials/menu/admin') %>
    </div>
  </nav>
</div>

<div id="layoutSidenav_content">
  <main>
    <div class="container-fluid px-4 mt-4">

      <h1 class="fw-bold mb-3">Pengaturan Sistem</h1>

      <!-- ===================== -->
      <!-- PENGATURAN UMUM -->
      <!-- ===================== -->

      <div class="card shadow-sm">
        <div class="card-body">

          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" checked>
            <label class="form-check-label">
              Aktifkan Email Notifikasi
            </label>
          </div>

          <div class="mb-3">
            <label class="form-label">Batas Upload File (MB)</label>
            <input type="number" class="form-control" value="10">
          </div>

          <button class="btn btn-success">
            Simpan Pengaturan
          </button>

        </div>
      </div>

      <!-- ===================== -->
      <!-- KELOLA JENIS HIBAH -->
      <!-- ===================== -->

      <div class="card shadow-sm mt-4">
        <div class="card-header fw-bold">
          Kelola Jenis Hibah
        </div>
        <div class="card-body">

          <!-- FORM TAMBAH -->
          <form method="POST" action="/users/admin/kategori-hibah" class="mb-4">
            <div class="row">
              <div class="col-md-8">
                <input type="text"
                       name="nama_kategori"
                       class="form-control"
                       placeholder="Nama jenis hibah"
                       required>
              </div>
              <div class="col-md-4">
                <button class="btn btn-success w-100">
                  Tambah
                </button>
              </div>
            </div>
          </form>

          <!-- TABEL LIST -->
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>Nama Jenis Hibah</th>
                <th style="width:120px">Aksi</th>
              </tr>
            </thead>
            <tbody>

              <% if (!kategori || kategori.length === 0) { %>
                <tr>
                  <td colspan="2" class="text-center text-muted">
                    Belum ada jenis hibah
                  </td>
                </tr>
              <% } %>

              <% if (kategori) { %>
                <% kategori.forEach(k => { %>
                  <tr>
                    <td><%= k.nama_kategori %></td>
                    <td>
                      <form method="POST"
                            action="/users/admin/kategori-hibah/<%= k.kategori_id %>/delete"
                            onsubmit="return confirm('Yakin hapus kategori ini?')">
                        <button class="btn btn-sm btn-danger w-100">
                          Hapus
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>

            </tbody>
          </table>

        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</div>