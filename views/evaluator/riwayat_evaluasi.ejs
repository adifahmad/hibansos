<%- include('../partials/header', { title: "Riwayat Evaluasi" , user }) %>

    <div id="layoutSidenav_nav">
        <nav class="sb-sidenav accordion spotify-green">
            <div class="sb-sidenav-menu">
                <%- include(`../partials/menu/${user.role}`) %>
            </div>
        </nav>
    </div>

    <div id="layoutSidenav_content">
        <main>
            <div class="container-fluid px-4 mt-4">

                <h1 class="fw-bold mb-2">Riwayat Evaluasi</h1>
                <p class="text-muted mb-4">
                    Daftar pengajuan yang sudah Anda evaluasi.
                </p>

                <div class="card shadow-sm">
                    <div class="card-body p-0">

                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Judul</th>
                                    <th>Kategori</th>
                                    <th>Dana (Rp)</th> <!-- TAMBAHAN -->
                                    <th>Dana Disetujui (Rp)</th> <!-- TAMBAHAN -->
                                    <th>Skor</th>
                                    <th>Rekomendasi</th>
                                    <th>Tanggal</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (data.length===0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="fas fa-clipboard-list fa-2x mb-2"></i><br>
                                            Belum ada evaluasi yang dilakukan
                                        </td>
                                    </tr>
                                    <% } %>

                                        <% data.forEach(e=> { %>
                                            <tr>
                                                <td>
                                                    <%= e.title %>
                                                </td>

                                                <td>
                                                    <%= e.category %>
                                                </td>

                                                <!-- TAMBAHAN -->
                                                <td>
                                                    <%= Number(e.request_amount || 0).toLocaleString('id-ID') %>
                                                </td>

                                                <td>
                                                    <%= Number(e.approved_amount || 0).toLocaleString('id-ID') %>
                                                </td>

                                                <td class="text-center fw-bold">
                                                    <%= e.score %>
                                                </td>

                                                <td>
                                                    <span class="badge px-3 py-2
          <%= e.recommendation === 'approve'
            ? 'bg-success'
            : 'bg-danger' %>">
                                                        <%= e.recommendation.toUpperCase() %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <% if (e.evaluated_at) { %>
                                                        <%= new Date(e.evaluated_at).toLocaleDateString('id-ID') %>
                                                            <% } else { %>
                                                                -
                                                                <% } %>
                                                </td>
                                            </tr>
                                            <% }) %>
                            </tbody>

                        </table>

                    </div>
                </div>

            </div>
        </main>

        <%- include('../partials/footer') %>
    </div>