<% if (p.recommendation==='approve' ) { %>

    <% if (!p.ttd_doc_id) { %>
        <small class="text-muted d-block mb-2">Silakan tanda tangan terlebih dahulu</small>
        <a href="/users/pemohon/ttd/<%= p.application_id %>" class="btn btn-sm btn-warning">
            <i class="fas fa-signature me-1"></i> Tanda Tangan
        </a>

        <% } else if (p.ttd_status==='pending' ) { %>
            <span class="badge bg-warning text-dark px-3 py-2">
                <i class="fas fa-clock me-1"></i> Menunggu Verifikasi TTD
            </span>

            <% } else if (p.ttd_status==='rejected' ) { %>
                <span class="badge bg-danger px-3 py-2 mb-2">TTD Ditolak</span><br>
                <a href="/users/pemohon/ttd/<%= p.application_id %>" class="btn btn-sm btn-warning mt-1">
                    <i class="fas fa-redo me-1"></i> Tanda Tangan Ulang
                </a>

                <% } else if (p.ttd_status==='approved' ) { %>
                    <span class="badge bg-success mb-2">TTD Terverifikasi ✓</span>
                    <hr class="my-1">
                    <small class="text-muted d-block mb-2">Tahap <%= approvedStage %> dari 4</small>

                    <% if (approvedStage>= 4) { %>
                        <span class="badge bg-success px-3 py-2">Progress Selesai</span>

                        <% } else if (p.pending_doc_id) { %>
                            <span class="badge bg-warning text-dark px-3 py-2">
                                <i class="fas fa-clock me-1"></i> Menunggu Persetujuan Admin
                            </span>
                            <br>
                            <a href="/uploads/<%= p.pending_file_path %>" target="_blank"
                                class="btn btn-sm btn-outline-secondary mt-1">
                                <i class="fas fa-image me-1"></i> Lihat Foto
                            </a>

                            <% } else { %>
                                <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                    data-bs-target="#modalUploadProgress" data-appid="<%= p.application_id %>"
                                    data-stage="<%= approvedStage + 1 %>">
                                    <i class="fas fa-upload me-1"></i> Upload Tahap <%= approvedStage + 1 %>
                                </button>
                                <% } %>

                                    <% } %>

                                        <% } else { %>
                                            <small class="text-muted">Menunggu persetujuan dana</small>
                                            <% } %>