<div class="card shadow-sm">
  <div class="card-header fw-bold">
    Tracking Proses
  </div>

  <div class="card-body" id="trackingTimeline">

    <div class="tracking-step" data-step="submitted">
      <div class="tracking-label">📝 Pengajuan Dibuat</div>
      <div class="tracking-time">Menunggu</div>
    </div>

    <div class="tracking-step" data-step="review">
      <div class="tracking-label">🔍 Review</div>
      <div class="tracking-time">Menunggu</div>
    </div>

    <div class="tracking-step" data-step="evaluation">
      <div class="tracking-label">📊 Evaluasi</div>
      <div class="tracking-time">Menunggu</div>
    </div>

    <div class="tracking-step" data-step="final">
      <div class="tracking-label">✅ Keputusan Final</div>
      <div class="tracking-time">Menunggu</div>
    </div>

  </div>
</div>
