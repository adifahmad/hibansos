<%- include('../partials/header', { title: "Detail Pengajuan Bansos" , user }) %>

    <div id="layoutSidenav_nav">
        <nav class="sb-sidenav accordion spotify-green">

            <div class="sb-sidenav-menu">
                <% if (user.role==='pemohon' ) { %>

                    <% if (user.rolepemohon==='individu' ) { %>
                        <%- include('../partials/menu/pemohon_individu') %>
                            <% } else { %>
                                <%- include('../partials/menu/pemohon_lembaga') %>
                                    <% } %>

                                        <% } else { %>
                                            <%- include('../partials/menu/' + user.role) %>
                                                <% } %>
            </div>

        </nav>
    </div>

    <div id="layoutSidenav_content">
        <main>
            <div class="container-fluid px-4">

                <h1 class="mt-4 fw-bold">Detail Pengajuan Bansos</h1>
                <p class="text-muted">Informasi lengkap pengajuan bantuan sosial</p>

                <div class="row mt-4">

                    <!-- ================= KIRI ================= -->
                    <div class="col-md-8">

                        <div class="card shadow-sm mb-4">
                            <div class="card-body">

                                <h4 class="fw-bold">
                                    <%= data.title %>
                                </h4>
                                <p class="text-muted">Kategori: <%= data.category %>
                                </p>

                                <hr>

                                <p>
                                    <strong>Jumlah Penerima:</strong><br>
                                    <%= data.beneficiaries_count ? data.beneficiaries_count.toLocaleString('id-ID')
                                        + ' orang' : '-' %>
                                </p>

                                <p>
                                    <strong>Tanggal Pengajuan:</strong><br>
                                    <%= data.submission_date ? new
                                        Date(data.submission_date).toLocaleDateString('id-ID') : '-' %>
                                </p>

                            </div>
                        </div>

                        <!-- ================= DOKUMEN ================= -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">

                                <h5 class="fw-bold">Dokumen Proposal</h5>

                                <% if (document) { %>

                                    <% if (document.file_path && document.file_path.endsWith('.pdf')) { %>
                                        <iframe src="/uploads/<%= document.file_path %>"
                                            style="width:100%; height:400px;"></iframe>
                                        <% } else { %>
                                            <img src="/uploads/<%= document.file_path %>" class="img-fluid rounded">
                                            <% } %>

                                                <a href="/uploads/<%= document.file_path %>" target="_blank"
                                                    class="btn btn-primary mt-2">
                                                    <i class="fas fa-eye"></i> Lihat Full
                                                </a>

                                                <% } else { %>

                                                    <div class="alert alert-warning">
                                                        Dokumen tidak ditemukan
                                                    </div>

                                                    <% } %>

                            </div>
                        </div>

                        <!-- BACK -->
                        <a href="/users/pemohon/pengajuan-saya-bansos" class="btn btn-secondary">
                            ← Kembali
                        </a>

                    </div>


                    <!-- ================= KANAN ================= -->
                    <div class="col-md-4">

                        <!-- STATUS -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-body">

                                <h6 class="fw-bold">Status Pengajuan</h6>

                                <% if (data.status_label==='Disetujui' ) { %>
                                    <span class="badge bg-success">Disetujui</span>

                                    <% } else if (data.status_label==='Ditolak' ) { %>
                                        <span class="badge bg-danger">Ditolak</span>

                                        <% } else if (data.status_label==='Menunggu Review' ) { %>
                                            <span class="badge bg-warning text-dark">Menunggu Review</span>

                                            <% } else if (data.status_label==='Menunggu Evaluasi' ) { %>
                                                <span class="badge bg-info">Menunggu Evaluasi</span>

                                                <% } else { %>
                                                    <span class="badge bg-secondary">
                                                        <%= data.status_label %>
                                                    </span>
                                                    <% } %>

                                                        <p class="mt-3 text-muted">
                                                            Tanggal Submit:<br>
                                                            <%= data.submission_date ? new
                                                                Date(data.submission_date).toLocaleDateString('id-ID')
                                                                : '-' %>
                                                        </p>

                            </div>
                        </div>


                        <!-- CATATAN REVIEWER -->
                        <% if (data.verification_notes) { %>
                            <div class="card shadow-sm mb-3">
                                <div class="card-body">

                                    <h6 class="fw-bold">Catatan Reviewer</h6>
                                    <p>
                                        <%= data.verification_notes %>
                                    </p>

                                </div>
                            </div>
                            <% } %>


                                <!-- HASIL EVALUASI -->
                                <% if (data.score || data.recommendation) { %>
                                    <div class="card shadow-sm">
                                        <div class="card-body">

                                            <h6 class="fw-bold">Hasil Evaluasi</h6>

                                            <% if (data.score) { %>
                                                <p>
                                                    Skor:
                                                    <span class="badge bg-primary">
                                                        <%= data.score %>/10
                                                    </span>
                                                </p>
                                                <% } %>

                                                    <% if (data.recommendation) { %>
                                                        <p>
                                                            Rekomendasi:
                                                            <span class="badge bg-success">
                                                                <%= data.recommendation %>
                                                            </span>
                                                        </p>
                                                        <% } %>

                                        </div>
                                    </div>
                                    <% } %>

                    </div>

                </div>

            </div>
        </main>

        <%- include('../partials/footer') %>
    </div>