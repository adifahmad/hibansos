<%- include('../partials/header', { title: "Edit Legalitas Bansos" , user }) %>

  <div id="layoutSidenav">

    <!-- SIDEBAR -->
    <div id="layoutSidenav_nav">
      <nav class="sb-sidenav accordion spotify-green">
        <div class="sb-sidenav-menu">
          <%- include('../partials/menu/pemohon_individu') %>
        </div>
      </nav>
    </div>

    <!-- CONTENT -->
    <div id="layoutSidenav_content">
      <main class="container-fluid px-4 mt-4">

        <h1 class="fw-bold mb-3">Edit Legalitas Bansos</h1>
        <p class="text-muted">Perbarui data pribadi Anda</p>

        <div class="card shadow-sm">
          <div class="card-body">

            <!-- STATUS -->
            <% if (legalitas) { %>
              <p>
                <strong>Status:</strong>

                <% if (legalitas.verification_status==='approved' ) { %>
                  <span class="badge bg-success">Terverifikasi</span>

                  <% } else if (legalitas.verification_status==='rejected' ) { %>
                    <span class="badge bg-danger">Ditolak</span>

                    <% } else if (legalitas.verification_status==='pending' ) { %>
                      <span class="badge bg-warning text-dark">Menunggu Verifikasi</span>

                      <% } %>
              </p>
              <% } %>

                <!-- FORM -->
                <form action="/users/pemohon/legalitas-bansos/edit" method="POST">

                  <!-- NIK -->
                  <div class="mb-3">
                    <label class="form-label fw-bold">Nomor KTP (NIK)</label>
                    <input type="text" name="nik" class="form-control" value="<%= legalitas?.nik || '' %>" required>
                  </div>

                  <!-- KK -->
                  <div class="mb-3">
                    <label class="form-label fw-bold">Nomor Kartu Keluarga</label>
                    <input type="text" name="no_kk" class="form-control" value="<%= legalitas?.no_kk || '' %>" required>
                  </div>

                  <button class="btn btn-warning">
                    <i class="fas fa-save"></i> Update Data
                  </button>

                  <a href="/users/pemohon/profile" class="btn btn-secondary ms-2">
                    Batal
                  </a>

                </form>

          </div>
        </div>

      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>