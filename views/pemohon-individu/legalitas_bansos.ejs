<%- include('../partials/header', { title: "Legalitas Bansos" , user }) %>

  <div id="layoutSidenav">

    <!-- SIDEBAR -->
    <div id="layoutSidenav_nav">
      <nav class="sb-sidenav accordion spotify-green">
        <div class="sb-sidenav-menu">
          <%- include('../partials/menu/pemohon_individu') %>
        </div>
      </nav>
    </div>

    <!-- CONTENT -->
    <div id="layoutSidenav_content">
      <div class="container-fluid px-4 mt-4 bansos-page" style="max-width: 100%;">

        <h1 class="fw-bold mb-3">Legalitas Bansos</h1>
        <p class="text-muted">Lengkapi data dan dokumen pribadi Anda</p>

        <div class="row bansos-wrapper">
          <div class="col-12 bansos-col">
            <div class="card shadow-sm bansos-card">
              <div class="card-body bansos-card-body">

                <% if (!legalitas) { %>

                  <!-- ================= FORM PERTAMA KALI ================= -->

                  <form class="bansos-form" action="/users/pemohon/legalitas" method="POST"
                    enctype="multipart/form-data">

                    <div class="mb-3">
                      <label class="form-label fw-bold">Nomor KTP (NIK)</label>
                      <input type="text" name="nik" class="form-control" maxlength="16" required>
                    </div>

                    <div class="mb-3">
                      <label class="form-label fw-bold">Nomor Kartu Keluarga</label>
                      <input type="text" name="no_kk" class="form-control" required>
                    </div>

                    <div class="mb-3">
                      <label class="form-label fw-bold">Upload KTP</label>
                      <input type="file" name="ktp" class="form-control" accept="image/*,application/pdf" required>
                    </div>

                    <div class="mb-3">
                      <label class="form-label fw-bold">Upload KK</label>
                      <input type="file" name="kk" class="form-control" accept="image/*,application/pdf" required>
                    </div>

                    <div class="mb-3">
                      <label class="form-label fw-bold">Upload SKTM</label>
                      <input type="file" name="sktm" class="form-control" accept="image/*,application/pdf" required>
                    </div>

                    <div class="mb-3">
                      <label class="form-label fw-bold">Foto Rumah</label>
                      <small class="text-muted d-block mb-1">Format: JPG, PNG, dll (bukan PDF)</small>
                      <input type="file" name="foto_rumah" class="form-control" accept="image/*">
                    </div>

                    <button class="btn btn-success">
                      <i class="fas fa-upload"></i> Simpan Legalitas
                    </button>

                  </form>

                  <% } else { %>

                    <!-- ================= DATA ================= -->

                    <p>
                      <strong>Status:</strong>
                      <% if (legalitas.verification_status==='approved' ) { %>
                        <span class="badge bg-success">Terverifikasi</span>
                        <% } else if (legalitas.verification_status==='rejected' ) { %>
                          <span class="badge bg-danger">Ditolak</span>
                          <% } else { %>
                            <span class="badge bg-warning text-dark">Menunggu Verifikasi</span>
                            <% } %>
                    </p>

                    <table class="table table-sm">
                      <tr>
                        <td>NIK</td>
                        <td>
                          <%= legalitas.nik %>
                        </td>
                      </tr>
                      <tr>
                        <td>No KK</td>
                        <td>
                          <%= legalitas.no_kk %>
                        </td>
                      </tr>
                    </table>

                    <% if (legalitas.verification_notes) { %>
                      <div class="alert alert-info mt-2">
                        <strong>Catatan Admin:</strong><br>
                        <%= legalitas.verification_notes %>
                      </div>
                      <% } %>

                        <!-- ================= DOKUMEN ================= -->

                        <div class="mt-4">
                          <h5 class="fw-bold">Dokumen Pendukung</h5>
                          <p class="text-muted">KTP, KK, SKTM, Foto Rumah</p>
                        </div>

                        <% if (!documents || documents.length===0) { %>
                          <div class="alert alert-warning">
                            Belum ada dokumen
                          </div>
                          <% } else { %>
                            <div class="row">
                              <% documents.forEach(d=> { %>
                                <div class="col-md-6 mb-3">
                                  <div class="border rounded p-3 h-100">

                                    <p class="fw-bold text-uppercase mb-2">
                                      <%= d.document_type %>
                                    </p>

                                    <% if (d.file_path && d.file_path.endsWith('.pdf')) { %>
                                      <iframe src="/uploads/<%= d.file_path %>"
                                        style="width:100%; height:220px; border:1px solid #ddd;">
                                      </iframe>
                                      <% } else { %>
                                        <img src="/uploads/<%= d.file_path %>" class="img-fluid rounded"
                                          style="height:220px; width:100%; object-fit:cover;">
                                        <% } %>

                                          <a href="/uploads/<%= d.file_path %>" target="_blank"
                                            class="btn btn-sm btn-outline-primary mt-2">
                                            <i class="fas fa-eye"></i> Lihat
                                          </a>

                                  </div>
                                </div>
                                <% }) %>
                            </div>
                            <% } %>

                              <% } %>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>