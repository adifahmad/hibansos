<%- include("../partials/header", { title: "Dashboard Pemohon" , user: user }) %>

    <div id="layoutSidenav" class="dashboard-page">

        <!-- SIDEBAR -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion spotify-green">
                <div class="sb-sidenav-menu">
                    <%- include("../partials/menu/" + user.role) %>
                </div>
            </nav>
        </div>

        <!-- CONTENT -->
        <div id="layoutSidenav_content">
            <main class="container-fluid px-4 mt-4">

                <h1 class="mt-4">Dashboard Pemohon</h1>
                <ol class="breadcrumb mb-4">
                    <li class="breadcrumb-item active">Ringkasan Pengajuan</li>
                </ol>

                <% var total=stats ? Number(stats.total) : 0; var menungguReview=stats ? Number(stats.menunggu_review) :
                    0; var menungguEvaluasi=stats ? Number(stats.menunggu_evaluasi) : 0; var menunggu=menungguReview +
                    menungguEvaluasi; var disetujui=stats ? Number(stats.disetujui) : 0; var ditolak=stats ?
                    Number(stats.ditolak) : 0; %>

                    <!-- ================= CARDS ================= -->
                    <div class="row">

                        <!-- TOTAL -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card text-white shadow h-100"
                                style="background:linear-gradient(135deg,#2f80ed,#1e66dc); border-radius:14px;">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fas fa-folder-open fa-2x me-3"></i>
                                    <div>
                                        <div class="fw-bold">Total Pengajuan</div>
                                        <h4 class="fw-bold mb-0">
                                            <%= total %>
                                        </h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- MENUNGGU -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card text-white shadow h-100"
                                style="background:linear-gradient(135deg,#f6c23e,#f4b400); border-radius:14px;">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fas fa-clock fa-2x me-3"></i>
                                    <div>
                                        <div class="fw-bold">Menunggu</div>
                                        <small>Review: <%= menungguReview %> | Evaluasi: <%= menungguEvaluasi %></small>
                                        <h4 class="fw-bold mb-0">
                                            <%= menunggu %>
                                        </h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- DISETUJUI -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card text-white shadow h-100"
                                style="background:linear-gradient(135deg,#1cc88a,#17a673); border-radius:14px;">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fas fa-check-circle fa-2x me-3"></i>
                                    <div>
                                        <div class="fw-bold">Disetujui</div>
                                        <h4 class="fw-bold mb-0">
                                            <%= disetujui %>
                                        </h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- DITOLAK -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card text-white shadow h-100"
                                style="background:linear-gradient(135deg,#e74a3b,#d63031); border-radius:14px;">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fas fa-times-circle fa-2x me-3"></i>
                                    <div>
                                        <div class="fw-bold">Ditolak</div>
                                        <h4 class="fw-bold mb-0">
                                            <%= ditolak %>
                                        </h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ================= CHARTS ================= -->
                    <div class="row mt-4 dashboard-charts">

                        <!-- AREA -->
                        <div class="col-xl-8 col-lg-7 mb-4">
                            <div class="card shadow chart-card">
                                <div class="card-header fw-bold">
                                    <i class="fas fa-chart-area me-1"></i>
                                    Pengajuan Per Bulan
                                </div>
                                <div class="card-body">
                                    <div class="chart-wrapper">
                                        <canvas id="areaChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- DONUT -->
                        <div class="col-xl-4 col-lg-5 mb-4">
                            <div class="card shadow chart-card">
                                <div class="card-header fw-bold">
                                    <i class="fas fa-chart-pie me-1"></i>
                                    Tingkat Keberhasilan
                                </div>
                                <div class="card-body d-flex justify-content-center align-items-center">
                                    <div class="chart-wrapper-donut">
                                        <canvas id="donutChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>

    <!-- ================= CHART JS ================= -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Ambil data dari backend
        const monthlyData = <%- JSON.stringify(chartData.monthly) %>;

        const labels = monthlyData.map(m => m.bulan);
        const values = monthlyData.map(m => parseInt(m.total));

        new Chart(document.getElementById("areaChart"), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: "Pengajuan",
                    data: values,
                    fill: true,
                    borderColor: "#1cc88a",
                    backgroundColor: "rgba(28,200,138,0.2)",
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        precision: 0
                    }
                }
            }
        });

        new Chart(document.getElementById("donutChart"), {
            type: 'doughnut',
            data: {
                labels: ["Disetujui", "Ditolak"],
                datasets: [{
                    data: [<%= stats.disetujui %>, <%= stats.ditolak %>],
                    backgroundColor: ["#1cc88a", "#e74a3b"]
                }]
            },
            options: {
                cutout: "65%",
                plugins: {
                    legend: { position: "bottom" }
                }
            }
        });
    </script>