<%- include('../partials/header', { title: "Edit Legalitas Lembaga", user }) %>

<div id="layoutSidenav_nav">
  <nav class="sb-sidenav accordion spotify-green">
    <div class="sb-sidenav-menu">
      <%- include('../partials/menu/${user.role}') %>
    </div>
  </nav>
</div>

<div id="layoutSidenav_content">
  <main>
    <div class="container-fluid px-4">

      <h1 class="mt-4 fw-bold">Edit Legalitas Lembaga</h1>
      <p class="text-muted">
        Perbarui status verifikasi dan berikan catatan kepada pemohon.
      </p>

      <form method="POST"
            action="/users/admin/legalitas/<%= data.legality_id %>/update"
            class="mt-4">

        <!-- INFO PEMOHON -->
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <p><strong>Nama:</strong> <%= data.name %></p>
            <p><strong>Organisasi:</strong> <%= data.organization || '-' %></p>
            <p><strong>NPWP:</strong> <%= data.npwp %></p>
          </div>
        </div>

        <!-- STATUS -->
        <div class="mb-3">
          <label class="form-label fw-bold">Status Verifikasi</label>
          <select name="verification_status" class="form-select" required>
            <option value="pending"
              <%= data.verification_status === 'pending' ? 'selected' : '' %>>
              Pending
            </option>
            <option value="approved"
              <%= data.verification_status === 'approved' ? 'selected' : '' %>>
              Approved
            </option>
            <option value="rejected"
              <%= data.verification_status === 'rejected' ? 'selected' : '' %>>
              Rejected
            </option>
          </select>
        </div>

        <!-- CATATAN -->
        <div class="mb-4">
          <label class="form-label fw-bold">Catatan Admin</label>
          <textarea name="verification_notes"
                    rows="4"
                    class="form-control"
                    placeholder="Alasan penolakan / catatan verifikasi">
<%= data.verification_notes || '' %>
          </textarea>
        </div>

        <!-- ACTION -->
        <div class="mt-4">
          <button type="submit" class="btn btn-success fw-bold px-4">
            <i class="fas fa-save me-2"></i> Simpan
          </button>

          <a href="/users/admin/legalitas"
             class="btn btn-secondary ms-2">
            Batal
          </a>
        </div>

      </form>

    </div>
  </main>

  <%- include('../partials/footer') %>
</div>
