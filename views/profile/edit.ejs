<%- include('../partials/header', { title: "Profil Saya" , user }) %>

    <div id="layoutSidenav_nav">
        <nav class="sb-sidenav accordion spotify-green">
            <div class="sb-sidenav-menu">
                <% if (user.role==='pemohon' ) { %>
                    <% if (user.rolepemohon==='individu' ) { %>
                        <%- include('../partials/menu/pemohon_individu') %>
                            <% } else { %>
                                <%- include('../partials/menu/pemohon_lembaga') %>
                                    <% } %>
                                        <% } else { %>
                                            <%- include('../partials/menu/' + user.role) %>
                                                <% } %>
            </div>
        </nav>
    </div>

    <div id="layoutSidenav_content">
        <main>
            <div class="container-fluid px-4 mt-4">

                <h1 class="fw-bold mb-3">Profil Saya</h1>
                <p class="text-muted">Perbarui data pribadi Anda.</p>

                <div class="card shadow-sm">
                    <div class="card-body">

                        <form method="POST" action="/users/profile">

                            <div class="mb-3">
                                <label class="form-label">Nama</label>
                                <input type="text" name="name" class="form-control" value="<%= data.name %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" class="form-control" value="<%= data.email %>"
                                    required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Organisasi</label>
                                <input type="text" name="organization" class="form-control"
                                    value="<%= data.organization %>">
                            </div>

                            <h4 class="fw-bold">
                                <% if (user.role==='pemohon' && user.rolepemohon==='individu' ) { %>
                                    Lokasi Rumah
                                    <% } else { %>
                                        Lokasi Lembaga
                                        <% } %>
                            </h4>

                            <p class="text-muted">
                                <% if (user.role==='pemohon' && user.rolepemohon==='individu' ) { %>
                                    Tentukan lokasi tempat tinggal Anda
                                    <% } else { %>
                                        Edit lokasi kegiatan / lembaga
                                        <% } %>
                            </p>

                            <form method="POST" action="/users/pemohon/profile/location/edit">
                                <input type="hidden" name="latitude" id="geo-lat" value="<%= data.latitude || '' %>">
                                <input type="hidden" name="longitude" id="geo-lng" value="<%= data.longitude || '' %>">
                                <input type="hidden" name="address" id="geo-address" value="<%= data.address || '' %>">

                                <div id="geo-map" style="height:300px;border-radius:8px;"></div>

                                <div class="mb-4 mt-4">
                                    <button class="btn btn-success">
                                        <i class="fas fa-map-marker-alt"></i> Simpan Lokasi
                                    </button>
                                </div>
                            </form>

                            <button class="btn btn-success">
                                <i class="fas fa-save"></i> Simpan
                            </button>

                        </form>

                        <hr class="my-4">

                        <!-- ================= LEGALITAS ================= -->

                        <h4 class="fw-bold">
                            <% if (user.role==='pemohon' && user.rolepemohon==='individu' ) { %>
                                Legalitas Bansos
                                <% } else { %>
                                    Legalitas Lembaga
                                    <% } %>
                        </h4>

                        <% if (user.role==='pemohon' && user.rolepemohon==='individu' ) { %>

                            <!-- ================= BANSOS ================= -->

                            <% if (bansosLegalitas) { %>
                                <p>
                                    <strong>Status:</strong>
                                    <% if (bansosLegalitas.verification_status==='approved' ) { %>
                                        <span class="badge bg-success">Terverifikasi</span>
                                        <% } else if (bansosLegalitas.verification_status==='rejected' ) { %>
                                            <span class="badge bg-danger">Ditolak</span>
                                            <% } else if (bansosLegalitas.verification_status==='pending' ) { %>
                                                <span class="badge bg-warning text-dark">Menunggu Verifikasi</span>
                                                <% } %>
                                </p>

                                <table class="table table-sm">
                                    <tr>
                                        <td>NIK</td>
                                        <td>
                                            <%= bansosLegalitas.nik || '-' %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>No KK</td>
                                        <td>
                                            <%= bansosLegalitas.no_kk || '-' %>
                                        </td>
                                    </tr>
                                </table>

                                <% if (bansosLegalitas.verification_status==='pending' ||
                                    bansosLegalitas.verification_status==='rejected' ) { %>
                                    <a href="/users/pemohon/legalitas-bansos/edit" class="btn btn-warning mb-3">
                                        <i class="fas fa-edit me-1"></i>
                                        <% if (bansosLegalitas.verification_status==='rejected' ) { %>
                                            Ajukan Ulang Legalitas
                                            <% } else { %>
                                                Edit Legalitas
                                                <% } %>
                                    </a>
                                    <% } %>
                                        <% } %>

                                            <% if (!documents || documents.length===0) { %>
                                                <div class="alert alert-warning">
                                                    Belum upload dokumen bansos
                                                    <a href="/users/pemohon/legalitas"
                                                        class="btn btn-sm btn-primary ms-2">
                                                        Upload Sekarang
                                                    </a>
                                                </div>
                                                <% } else { %>
                                                    <div class="row">
                                                        <% documents.forEach(d=> { %>
                                                            <div class="col-md-6 mb-3">
                                                                <div class="border rounded p-3 h-100 position-relative">

                                                                    <!-- TOMBOL X BANSOS -->
                                                                    <% if (bansosLegalitas &&
                                                                        (bansosLegalitas.verification_status==='pending'
                                                                        ||
                                                                        bansosLegalitas.verification_status==='rejected'
                                                                        )) { %>
                                                                        <form method="POST"
                                                                            action="/users/pemohon/legalitas/document/delete"
                                                                            style="position:absolute; top:8px; right:8px;">
                                                                            <input type="hidden" name="document_id"
                                                                                value="<%= d.documents_id %>">
                                                                            <button type="submit"
                                                                                class="btn btn-sm btn-danger"
                                                                                onclick="return confirm('Hapus dokumen ini?')">
                                                                                <i class="fas fa-times"></i>
                                                                            </button>
                                                                        </form>
                                                                        <% } %>

                                                                            <p class="fw-bold mb-1">
                                                                                <i class="fas fa-paperclip me-1"></i>
                                                                                <%= d.file_name %>
                                                                            </p>

                                                                            <span class="badge bg-secondary mb-2">
                                                                                <%= d.document_type %>
                                                                            </span>

                                                                            <% if (d.file_path &&
                                                                                d.file_path.endsWith('.pdf')) { %>
                                                                                <iframe
                                                                                    src="/uploads/<%= d.file_path %>"
                                                                                    style="width:100%; height:220px;"></iframe>
                                                                                <% } else { %>
                                                                                    <img src="/uploads/<%= d.file_path %>"
                                                                                        class="img-fluid rounded"
                                                                                        style="height:220px; width:100%; object-fit:cover;">
                                                                                    <% } %>

                                                                                        <a href="/uploads/<%= d.file_path %>"
                                                                                            target="_blank"
                                                                                            class="btn btn-sm btn-outline-primary mt-2">
                                                                                            <i class="fas fa-eye"></i>
                                                                                            Lihat
                                                                                        </a>

                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>

                                                        <% } else { %>

                                                            <!-- ================= HIBAH ================= -->

                                                            <% if (!legalitas) { %>
                                                                <div class="alert alert-warning">
                                                                    Legalitas belum diisi
                                                                    <a href="/users/pemohon/legalitas"
                                                                        class="btn btn-sm btn-primary ms-2">
                                                                        Lengkapi Sekarang
                                                                    </a>
                                                                </div>
                                                                <% } else { %>

                                                                    <p>
                                                                        <strong>Status:</strong>
                                                                        <% if
                                                                            (legalitas.verification_status==='approved'
                                                                            ) { %>
                                                                            <span
                                                                                class="badge bg-success">Terverifikasi</span>
                                                                            <% } else if
                                                                                (legalitas.verification_status==='rejected'
                                                                                ) { %>
                                                                                <span
                                                                                    class="badge bg-danger">Ditolak</span>
                                                                                <% } else { %>
                                                                                    <span
                                                                                        class="badge bg-warning text-dark">Menunggu
                                                                                        Verifikasi</span>
                                                                                    <% } %>
                                                                    </p>

                                                                    <table class="table table-sm">
                                                                        <tr>
                                                                            <td>Nomor Akta</td>
                                                                            <td>
                                                                                <%= legalitas.deed_number || '-' %>
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td>Notaris</td>
                                                                            <td>
                                                                                <%= legalitas.notary_name || '-' %>
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td>NIB</td>
                                                                            <td>
                                                                                <%= legalitas.nib || '-' %>
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td>NPWP</td>
                                                                            <td>
                                                                                <%= legalitas.npwp || '-' %>
                                                                            </td>
                                                                        </tr>
                                                                    </table>

                                                                    <!-- TOMBOL EDIT/AJUKAN ULANG HIBAH -->
                                                                    <% if (legalitas.verification_status==='pending' ||
                                                                        legalitas.verification_status==='rejected' ) {
                                                                        %>
                                                                        <a href="/users/pemohon/legalitas/edit"
                                                                            class="btn btn-warning mb-3">
                                                                            <i class="fas fa-edit me-1"></i>
                                                                            <% if
                                                                                (legalitas.verification_status==='rejected'
                                                                                ) { %>
                                                                                Ajukan Ulang Legalitas
                                                                                <% } else { %>
                                                                                    Edit Legalitas
                                                                                    <% } %>
                                                                        </a>
                                                                        <% } %>

                                                                            <div class="row">
                                                                                <% documents.forEach(d=> { %>
                                                                                    <div class="col-md-6 mb-3">
                                                                                        <div
                                                                                            class="border rounded p-3 position-relative">

                                                                                            <!-- TOMBOL X HIBAH -->
                                                                                            <% if
                                                                                                (legalitas.verification_status==='pending'
                                                                                                ||
                                                                                                legalitas.verification_status==='rejected'
                                                                                                ) { %>
                                                                                                <form method="POST"
                                                                                                    action="/users/pemohon/legalitas/document/delete"
                                                                                                    style="position:absolute; top:8px; right:8px;">
                                                                                                    <input type="hidden"
                                                                                                        name="document_id"
                                                                                                        value="<%= d.documents_id %>">
                                                                                                    <button
                                                                                                        type="submit"
                                                                                                        class="btn btn-sm btn-danger"
                                                                                                        onclick="return confirm('Hapus dokumen ini?')">
                                                                                                        <i
                                                                                                            class="fas fa-times"></i>
                                                                                                    </button>
                                                                                                </form>
                                                                                                <% } %>

                                                                                                    <p class="fw-bold">
                                                                                                        <%= d.file_name
                                                                                                            %>
                                                                                                    </p>

                                                                                                    <% if (d.file_path
                                                                                                        &&
                                                                                                        d.file_path.endsWith('.pdf'))
                                                                                                        { %>
                                                                                                        <iframe
                                                                                                            src="/uploads/<%= d.file_path %>"
                                                                                                            style="width:100%; height:200px;"></iframe>
                                                                                                        <% } %>

                                                                                                            <a href="/uploads/<%= d.file_path %>"
                                                                                                                target="_blank"
                                                                                                                class="btn btn-sm btn-outline-primary mt-2">
                                                                                                                Lihat
                                                                                                            </a>

                                                                                        </div>
                                                                                    </div>
                                                                                    <% }) %>
                                                                            </div>

                                                                            <% } %>

                                                                                <% } %>

                    </div>
                </div>
            </div>
        </main>

        <script>
            let map, marker, geocoder;

            function initMap() {
                const lat = parseFloat(document.getElementById('geo-lat').value);
                const lng = parseFloat(document.getElementById('geo-lng').value);

                const center = { lat, lng };

                map = new google.maps.Map(document.getElementById('geo-map'), {
                    center,
                    zoom: 14
                });

                geocoder = new google.maps.Geocoder();

                marker = new google.maps.Marker({
                    position: center,
                    map,
                    draggable: true
                });

                function update(pos) {
                    document.getElementById('geo-lat').value = pos.lat();
                    document.getElementById('geo-lng').value = pos.lng();

                    geocoder.geocode({ location: pos }, (res, status) => {
                        if (status === 'OK' && res[0]) {
                            document.getElementById('geo-address').value = res[0].formatted_address;
                        }
                    });
                }

                marker.addListener('dragend', e => update(e.latLng));
                map.addListener('click', e => {
                    marker.setPosition(e.latLng);
                    update(e.latLng);
                });
            }
        </script>

        <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBVwNA-qXTdffMhWW8YsclY5_Z9ZwKffKE&libraries=places&callback=initMap">
            </script>

        <%- include('../partials/footer') %>
    </div>