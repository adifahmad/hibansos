<%- include("../partials/header", { title: "Dashboard Reviewer" , user }) %>

<div id="layoutSidenav" class="dashboard-page">

    <!-- SIDEBAR -->
    <div id="layoutSidenav_nav">
        <nav class="sb-sidenav accordion spotify-green">
            <div class="sb-sidenav-menu">
                <%- include("../partials/menu/" + user.role) %>
            </div>
        </nav>
    </div>

    <!-- CONTENT -->
    <div id="layoutSidenav_content">
        <main class="container-fluid px-4 mt-4">

            <h1 class="mt-4">Dashboard Reviewer</h1>
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item active">Ringkasan Review</li>
            </ol>

            <% 
                const total = Number(stats.total_masuk || 0);
                const sudah = Number(stats.sudah_review || 0);
                const menunggu = Number(stats.menunggu_review || 0);
            %>

            <!-- ================= CARDS ================= -->
            <div class="row">

                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="gradient-card bg-blue">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle">
                                <i class="fas fa-inbox"></i>
                            </div>
                            <div>
                                <div class="card-title">Total Masuk</div>
                                <h3><%= total %></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="gradient-card bg-yellow">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <div class="card-title">Menunggu Review</div>
                                <h3><%= menunggu %></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="gradient-card bg-green">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle">
                                <i class="fas fa-check"></i>
                            </div>
                            <div>
                                <div class="card-title">Sudah Direview</div>
                                <h3><%= sudah %></h3>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================= CHARTS ================= -->
            <div class="row">

                <!-- DISTRIBUSI KATEGORI -->
                <div class="col-xl-6 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header fw-bold">
                            <i class="fas fa-chart-pie me-1"></i>
                            Distribusi Kategori
                        </div>
                        <div class="card-body d-flex justify-content-center align-items-center">
                            <div style="width:220px;">
                                <canvas id="kategoriChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RATA-RATA DANA -->
                <div class="col-xl-6 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header fw-bold">
                            <i class="fas fa-chart-bar me-1"></i>
                            Rata-rata Dana Disetujui
                        </div>
                        <div class="card-body">
                            <canvas id="rataDanaChart"></canvas>
                        </div>
                    </div>
                </div>

            </div>

        </main>

        <%- include("../partials/footer") %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // ================= DONUT KATEGORI =================
    const kategoriData = <%- JSON.stringify(chartData.kategori || []) %>;

    const kategoriLabels = kategoriData.map(k => k.category);
    const kategoriValues = kategoriData.map(k => parseInt(k.total));

    new Chart(document.getElementById("kategoriChart"), {
        type: 'doughnut',
        data: {
            labels: kategoriLabels,
            datasets: [{
                data: kategoriValues,
                backgroundColor: [
                    "#4e73df",
                    "#1cc88a",
                    "#36b9cc",
                    "#f6c23e",
                    "#e74a3b"
                ]
            }]
        },
        options: {
            cutout: "65%",
            plugins: {
                legend: { position: "bottom" }
            }
        }
    });

    // ================= RATA-RATA DANA =================
    const rataDanaData = <%- JSON.stringify(chartData.rataDana || []) %>;

    const bulanLabels = rataDanaData.map(r => r.bulan);
    const rataValues = rataDanaData.map(r => parseFloat(r.rata_dana));

    new Chart(document.getElementById("rataDanaChart"), {
        type: 'bar',
        data: {
            labels: bulanLabels,
            datasets: [{
                label: "Rata-rata Dana",
                data: rataValues,
                backgroundColor: "#8e44ad"
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return "Rp " + value.toLocaleString("id-ID");
                        }
                    }
                }
            }
        }
    });
</script>