<%- include('../partials/header', { title: "Riwayat Review" , user }) %>

    <div id="layoutSidenav_nav">
        <nav class="sb-sidenav accordion spotify-green">
            <div class="sb-sidenav-menu">
                <%- include(`../partials/menu/${user.role}`) %>
            </div>
        </nav>
    </div>

    <div id="layoutSidenav_content">
        <main>
            <div class="container-fluid px-4">

                <h1 class="mt-4 fw-bold">Riwayat Review</h1>
                <p class="text-muted">
                    Daftar pengajuan yang telah Anda review.
                </p>

                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-history me-1"></i>
                        Riwayat Review
                    </div>

                    <div class="card-body">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Judul</th>
                                    <th>Kategori</th>
                                    <th>Dana (Rp)</th>
                                    <th>Dana Disetujui (Rp)</th> <!-- TAMBAHAN -->
                                    <th>Status Review</th>
                                    <th>Tanggal Review</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (data.length===0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            Belum ada riwayat review
                                        </td>
                                    </tr>
                                    <% } %>

                                        <% data.forEach(p=> { %>
                                            <tr>
                                                <td>
                                                    <%= p.title %>
                                                </td>

                                                <td>
                                                    <%= p.category %>
                                                </td>

                                                <td>
                                                    <%= Number(p.request_amount || 0).toLocaleString('id-ID') %>
                                                </td>

                                                <!-- TAMBAHAN -->
                                                <td>
                                                    <%= Number(p.approved_amount || 0).toLocaleString('id-ID') %>
                                                </td>

                                                <td>
                                                    <span class="badge
          <%= p.review_status === 'approved'
            ? 'bg-success'
            : 'bg-danger' %>">
                                                        <%= p.review_status %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <% const reviewedDate=p.reviewed_at ? new Date(p.reviewed_at) :
                                                        null; %>
                                                        <% if (reviewedDate && !isNaN(reviewedDate)) { %>
                                                            <%= reviewedDate.toLocaleDateString('id-ID') %>
                                                                <% } else { %>
                                                                    <span class="text-muted fst-italic">-</span>
                                                                    <% } %>
                                                </td>

                                                <td>
                                                    <a href="/users/reviewer/pengajuan/<%= p.application_id %>"
                                                        class="btn btn-sm btn-info">
                                                        <i class="fas fa-eye"></i> Detail
                                                    </a>
                                                </td>
                                            </tr>
                                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>

        <%- include('../partials/footer') %>
    </div>