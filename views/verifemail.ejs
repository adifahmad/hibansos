<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verifikasi Email</title>


<!-- LINK CSS TERPISAH -->
<link rel="stylesheet" href="/stylesheets/css/styles.css">
</head>


<body>


<div class="verify-otp-page">
<div class="verify-container">


<img src="/images/dollar.png" width="50" style="margin-bottom:10px;">


<div class="brand-box">
<div class="brand-title">HIBANSOS</div>
<div class="brand-sub">APP</div>
</div>


<img src="/images/verifikasi.png" class="hero">


<h1 class="title">Verifikasi Email Kamu</h1>
<p class="desc">Masukkan 6 digit kode OTP yang kami kirim ke emailmu.</p>


<!-- tambahan: tampilkan email tujuan & tombol kirim OTP (POST ke /register/send-otp) -->
<div style="margin:12px 0;">
<p class="muted">Email tujuan: <strong><%= typeof email !== 'undefined' && email ? email : '(belum tersedia)' %></strong></p>
<form id="sendOtpForm" method="post" action="/register/send-otp" style="margin-top:8px;">
<button type="submit" class="btn-send">Kirim OTP ke alamat di atas</button>
</form>
</div>


<form id="otpForm" method="POST" action="/register/verify-otp" autocomplete="off">


<div class="otp-row">
<input maxlength="1" class="otp-input" id="d0">
<input maxlength="1" class="otp-input" id="d1">
<input maxlength="1" class="otp-input" id="d2">
<input maxlength="1" class="otp-input" id="d3">
<input maxlength="1" class="otp-input" id="d4">
<input maxlength="1" class="otp-input" id="d5">
</div>


<input type="hidden" name="otp" id="otpHidden">


<button type="submit" class="btn-verify">Verifikasi</button>


<div class="note">
Tidak menerima kode? <a href="/register/send-otp">Kirim ulang</a>
</div>


</form>


</div>
</div>




<script>
const inputs = [...document.querySelectorAll(".otp-input")];
inputs[0].focus();


inputs.forEach((input, i) => {
input.addEventListener("input", () => {
input.value = input.value.replace(/\D/g, "");
if (input.value && i < inputs.length - 1) inputs[i+1].focus();
});


input.addEventListener("keydown", (e) => {
if (e.key === "Backspace" && !input.value && i > 0) {
inputs[i-1].focus();
}
});


input.addEventListener("paste", (e) => {
e.preventDefault();
const paste = (e.clipboardData || window.clipboardData)
.getData("text")
.replace(/\D/g, "")
.slice(0, 6);
paste.split("").forEach((num, idx) => {
if (inputs[idx]) inputs[idx].value = num;
});
inputs[paste.length - 1]?.focus();
});
});


document.getElementById("otpForm").addEventListener("submit", (e) => {
const otp = inputs.map(x => x.value).join("");
if (otp.length !== 6) {
e.preventDefault();
alert("Masukkan 6 digit OTP dengan benar.");
return;
}
document.getElementById("otpHidden").value = otp;
});
</script>


</body>
</html>